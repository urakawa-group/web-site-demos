@article{Urakawa.SensitivityEnhancementDynamic.2008,
	title = {Sensitivity enhancement and dynamic behavior analysis by modulation excitation spectroscopy: Principle and application in heterogeneous catalysis},
	volume = {63},
	issn = {0009-2509},
	url = {https://www.sciencedirect.com/science/article/pii/S0009250907004733},
	doi = {10.1016/j.ces.2007.06.009},
	series = {5TH Unsteady-State Processes in Catalysis: a Special Issue of Chemical Engineering Science},
	shorttitle = {Sensitivity enhancement and dynamic behavior analysis by modulation excitation spectroscopy},
	abstract = {Modulation excitation spectroscopy ({MES}) allows sensitive and selective detection and monitoring of the dynamic behavior of species directly involved in a reaction. The method, combined with proper in situ spectroscopy, is powerful for elucidating complex systems and noisy data as often encountered in heterogeneous catalytic reactions at solid–liquid and solid–gas interfaces under working conditions. The theoretical principle and actual data processing of {MES} are explained in detail. Periodic perturbation of the system by an external parameter, such as concentration and temperature, is utilized as stimulation in {MES}. The influence of stimulation shape upon response analysis is explained. Furthermore, an illustrative example of {MES}, enantioselective hydrogenation at a solid-liquid interface, is presented.},
	pages = {4902--4909},
	number = {20},
	journaltitle = {Chemical Engineering Science},
	shortjournal = {Chemical Engineering Science},
	author = {Urakawa, Atsushi and Bürgi, Thomas and Baiker, Alfons},
	urldate = {2024-11-28},
	date = {2008-10-01},
	keywords = {useful, well-written, big-deal},
	file = {ScienceDirect Snapshot:C\:\\Users\\jsommer1\\Zotero\\storage\\43E862EW\\S0009250907004733.html:text/html;Urakawa et al._2008_Sensitivity enhancement and dynamic behavior analysis by modulation excitation spectroscopy Princip.pdf:C\:\\Users\\jsommer1\\OneDrive\\[Literature]\\Urakawa et al._2008_Sensitivity enhancement and dynamic behavior analysis by modulation excitation spectroscopy Princip.pdf:application/pdf},
}

