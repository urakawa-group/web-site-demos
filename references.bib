@article{Keller.EvolvingFactorAnalysis.1991,
	title = {Evolving factor analysis},
	volume = {12},
	issn = {0169-7439},
	url = {https://www.sciencedirect.com/science/article/pii/016974399280002L},
	doi = {10.1016/0169-7439(92)80002-L},
	series = {Papers Presented at the Seventeenth Annual Meeting of the Federation of Analytical Chemistry and Spectroscopy Societies},
	abstract = {Evolving factor analysis ({EFA}) is a general method for the analysis of multivariate data having an intrinsic order. Examples are data produced by many hyphenated techniques, such as high-performance liquid chromatography with photodiode array detection ({HPLC}-{DAD}) and the study of complex equilibria by ultraviolet spectrometry as a function of {pH}. {EFA} relies on an intrinsic order of the data and relies on only a few assumptions, such as nonnegativity of concentrations and the validity of Beer's law. The method can be applied to curve resolution and the assessment of peak purity in different disciplines of analytical chemistry. A didactic example from {HPLC}-{DAD} is used to illustrate the method. Possible limitations of {EFA} are also discussed.},
	pages = {209--224},
	number = {3},
	journaltitle = {Chemometrics and Intelligent Laboratory Systems},
	shortjournal = {Chemometrics and Intelligent Laboratory Systems},
	author = {Keller, H. R. and Massart, D. L.},
	urldate = {2026-11-23},
	date = {1991-01-01},
	file = {Keller and Massart_1991_Evolving factor analysis.pdf:C\:\\Users\\jsommer1\\OneDrive\\[Literature]\\Keller and Massart_1991_Evolving factor analysis.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\jsommer1\\Zotero\\storage\\N3VFJRAV\\016974399280002L.html:text/html},
}
